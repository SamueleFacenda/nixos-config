#!/usr/bin/env bash
# .git/hooks/pre-commit - Runs before each commit
# Installed via: cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔍 Running pre-commit checks...${NC}"

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Nix formatting
NIX_FILES=$(echo "$STAGED_FILES" | grep '\.nix$' || true)
if [ -n "$NIX_FILES" ]; then
    echo "Checking Nix formatting..."
    if ! nix fmt --check $NIX_FILES; then
        echo -e "${RED}❌ Nix formatting failed. Run 'nix fmt' to fix.${NC}"
        exit 1
    fi
fi

# Python formatting/linting (ruff)
PY_FILES=$(echo "$STAGED_FILES" | grep '\.py$' || true)
if [ -n "$PY_FILES" ]; then
    echo "Running ruff..."
    if ! ruff check $PY_FILES; then
        echo -e "${RED}❌ Ruff check failed. Run 'ruff check --fix' to fix.${NC}"
        exit 1
    fi
    if ! ruff format --check $PY_FILES; then
        echo -e "${RED}❌ Ruff format failed. Run 'ruff format' to fix.${NC}"
        exit 1
    fi
fi

# Rust formatting/linting
RS_FILES=$(echo "$STAGED_FILES" | grep '\.rs$' || true)
if [ -n "$RS_FILES" ]; then
    echo "Checking Rust formatting..."
    if ! cargo fmt --check; then
        echo -e "${RED}❌ Rust formatting failed. Run 'cargo fmt' to fix.${NC}"
        exit 1
    fi
    echo "Running clippy..."
    if ! cargo clippy -- -D warnings; then
        echo -e "${RED}❌ Clippy check failed.${NC}"
        exit 1
    fi
fi

# TypeScript/JavaScript formatting (prettier)
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|json|yaml|yml|md|css|html)$' || true)
if [ -n "$TS_FILES" ]; then
    echo "Checking Prettier formatting..."
    if ! prettier --check $TS_FILES; then
        echo -e "${RED}❌ Prettier formatting failed. Run 'prettier --write' to fix.${NC}"
        exit 1
    fi
fi

# Lua formatting
LUA_FILES=$(echo "$STAGED_FILES" | grep '\.lua$' || true)
if [ -n "$LUA_FILES" ]; then
    echo "Checking StyLua formatting..."
    if ! stylua --check $LUA_FILES; then
        echo -e "${RED}❌ StyLua formatting failed. Run 'stylua' to fix.${NC}"
        exit 1
    fi
fi

# TOML formatting
TOML_FILES=$(echo "$STAGED_FILES" | grep '\.toml$' || true)
if [ -n "$TOML_FILES" ]; then
    echo "Checking Taplo formatting..."
    if ! taplo format --check $TOML_FILES; then
        echo -e "${RED}❌ Taplo formatting failed. Run 'taplo format' to fix.${NC}"
        exit 1
    fi
fi

# Security scan (semgrep) - quick check on staged files
if [ -n "$STAGED_FILES" ]; then
    echo "Running security scan..."
    if ! semgrep --config=auto --error $STAGED_FILES 2>/dev/null; then
        echo -e "${RED}❌ Security issues found. Review and fix.${NC}"
        exit 1
    fi
fi

# Secret detection
if ! git-secrets --scan $STAGED_FILES 2>/dev/null; then
    echo -e "${RED}❌ Potential secrets detected in staged files.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"