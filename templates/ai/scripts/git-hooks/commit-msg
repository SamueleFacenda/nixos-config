#!/usr/bin/env bash
# .git/hooks/commit-msg - Validates commit message format
# Installed via: cp scripts/git-hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Conventional commit regex
# Format: <type>(<scope>): <subject>
# Types: feat, fix, chore, docs, refactor, test, style, perf, ci, build, revert
CONVENTIONAL_REGEX='^(feat|fix|chore|docs|refactor|test|style|perf|ci|build|revert)(\(.+\))?: .+'

# Check format
if ! echo "$COMMIT_MSG" | grep -qE "$CONVENTIONAL_REGEX"; then
    echo "❌ Invalid commit message format"
    echo ""
    echo "Expected format: <type>(<scope>): <subject>"
    echo ""
    echo "Types:"
    echo "  feat      - New feature"
    echo "  fix       - Bug fix"
    echo "  chore     - Maintenance"
    echo "  docs      - Documentation"
    echo "  refactor  - Code restructuring"
    echo "  test      - Tests"
    echo "  style     - Formatting"
    echo "  perf      - Performance"
    echo "  ci        - CI/CD"
    echo "  build     - Build system"
    echo "  revert    - Revert commit"
    echo ""
    echo "Examples:"
    echo "  feat(auth): add OAuth2 login support"
    echo "  fix(parser): handle empty input gracefully"
    echo "  refactor(api): simplify response handling"
    echo ""
    echo "Your message:"
    echo "$COMMIT_MSG"
    exit 1
fi

# Check subject length (max 72 chars)
SUBJECT=$(echo "$COMMIT_MSG" | head -1)
if [ ${#SUBJECT} -gt 72 ]; then
    echo "⚠️  Warning: Subject line exceeds 72 characters (${#SUBJECT})"
    echo "   Consider shortening: $SUBJECT"
fi

# Check for breaking change footer
if echo "$COMMIT_MSG" | grep -q "BREAKING CHANGE"; then
    echo "⚠️  Breaking change detected - ensure version bump and changelog entry"
fi

exit 0