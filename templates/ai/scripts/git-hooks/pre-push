#!/usr/bin/env bash
# .git/hooks/pre-push - Runs before push
# Installed via: cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🚀 Running pre-push checks...${NC}"

# Determine project type and run appropriate checks
if [ -f "Cargo.toml" ]; then
    echo "Rust project detected - running tests..."
    if ! cargo nextest run --profile=ci; then
        echo -e "${RED}❌ Rust tests failed${NC}"
        exit 1
    fi
    echo "Running cargo audit..."
    if ! cargo audit; then
        echo -e "${RED}❌ Cargo audit found vulnerabilities${NC}"
        exit 1
    fi
fi

if [ -f "pyproject.toml" ] || [ -f "requirements.txt" ] || [ -f "setup.py" ]; then
    echo "Python project detected - running tests..."
    if ! pytest --cov=src --cov-fail-under=80; then
        echo -e "${RED}❌ Python tests failed or coverage below 80%${NC}"
        exit 1
    fi
    echo "Running pip-audit..."
    if ! pip-audit; then
        echo -e "${RED}❌ Pip audit found vulnerabilities${NC}"
        exit 1
    fi
fi

if [ -f "package.json" ]; then
    echo "Node.js project detected - running tests..."
    if ! npm test; then
        echo -e "${RED}❌ Node.js tests failed${NC}"
        exit 1
    fi
    echo "Running npm audit..."
    if ! npm audit --audit-level=high; then
        echo -e "${RED}❌ NPM audit found high/critical vulnerabilities${NC}"
        exit 1
    fi
fi

# Run full security scan
echo "Running full security scan..."
if ! nix build .#checks.x86_64-linux.security 2>/dev/null; then
    echo -e "${YELLOW}⚠️  Security scan had issues (non-blocking)${NC}"
fi

# Check if we're pushing to main/master (require PR)
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
    echo -e "${RED}❌ Direct push to main/master not allowed. Use feature branch and PR.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ All pre-push checks passed!${NC}"
exit 0