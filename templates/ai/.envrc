# Direnv configuration for AI-assisted development project
# Automatically loads nix flake dev shell

use flake

# Load local overrides if they exist
if has direnv_load; then
  direnv_load .envrc.local 2>/dev/null || true
fi

# Export common environment variables
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-nvim}"
export PAGER="${PAGER:-bat}"
export BAT_THEME="${BAT_THEME:-Catppuccin Mocha}"

# Project-specific settings
export PROJECT_ROOT="$(pwd)"
export PATH="${PROJECT_ROOT}/.local/bin:${PATH}"

# Rust settings
export CARGO_HOME="${PROJECT_ROOT}/.cargo"
export RUSTUP_HOME="${PROJECT_ROOT}/.rustup"

# Python settings
export UV_PROJECT_ENV="${PROJECT_ROOT}/.venv"
export UV_CACHE_DIR="${PROJECT_ROOT}/.cache/uv"

# Node.js settings
export NODE_ENV="${NODE_ENV:-development}"
export PNPM_HOME="${PROJECT_ROOT}/.pnpm"
export PATH="${PNPM_HOME}:${PATH}"

# AI agent settings (OpenRouter only)
export OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
export OPENROUTER_API_KEY=""  # Set via direnv .envrc.local or sops

# Memory configuration
export AI_MEMORY_DIR="${PROJECT_ROOT}/.ai-memory"
export AI_MEMORY_GLOBAL="${HOME}/.config/ai-memory"

# Pre-commit
export PRE_COMMIT_HOME="${PROJECT_ROOT}/.cache/pre-commit"

# Git
export GIT_AUTHOR_NAME="$(git config user.name)"
export GIT_AUTHOR_EMAIL="$(git config user.email)"
export GIT_COMMITTER_NAME="${GIT_AUTHOR_NAME}"
export GIT_COMMITTER_EMAIL="${GIT_AUTHOR_EMAIL}"