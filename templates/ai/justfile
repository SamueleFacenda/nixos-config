# Justfile - Command runner for AI-assisted development project
# Provides consistent commands across all environments

# Default target
default: help

# Help
help:
	@just --list

# Development
dev-shell:
	nix develop

dev-shell-impure:
	nix develop --impure

# Formatting & Linting (via pre-commit from flake)
fmt:
	pre-commit-run

fmt-check:
	pre-commit-run

# Testing
test:
	@echo "Running tests..."
	@if [ -f "Cargo.toml" ]; then cargo nextest run --profile=ci; fi
	@if [ -f "pyproject.toml" ]; then uv run pytest -v --cov=src --cov-fail-under=80; fi
	@if [ -f "package.json" ]; then npx vitest run --coverage; fi

test-watch:
	@if [ -f "Cargo.toml" ]; then cargo watch -x "nextest run"; fi
	@if [ -f "pyproject.toml" ]; then uv run pytest --watch; fi
	@if [ -f "package.json" ]; then npx vitest watch; fi

# Type checking
type-check:
	@if [ -f "pyproject.toml" ]; then uv run mypy .; fi
	@if [ -f "package.json" ]; then npx tsc --noEmit; fi

# Security (via nix flake check --checks security)
security:
	nix flake check --show-trace --checks security

# Dependency management
deps-update:
	@echo "Updating dependencies..."
	@if [ -f "Cargo.toml" ]; then cargo update; fi
	@if [ -f "pyproject.toml" ]; then uv lock --upgrade; fi
	@if [ -f "package.json" ]; then npx npm-check-updates -u && npm install; fi

deps-check:
	@echo "Checking for outdated dependencies..."
	@if [ -f "Cargo.toml" ]; then cargo outdated; fi
	@if [ -f "pyproject.toml" ]; then uv pip list --outdated; fi
	@if [ -f "package.json" ]; then npx npm-check-updates; fi

# Build
build:
	@echo "Building project..."
	@if [ -f "Cargo.toml" ]; then cargo build --release; fi
	@if [ -f "pyproject.toml" ]; then uv build; fi
	@if [ -f "package.json" ]; then npm run build; fi

build-docker:
	docker build -t {{project_name}}:latest .
	docker build -t {{project_name}}:$(git rev-parse --short HEAD) .

# Git
git-status:
	git status

git-diff:
	git diff

git-log:
	git log --oneline -20

# Release
changelog:
	@echo "Generating changelog..."
	git cliff --config .cliff.toml -o CHANGELOG.md

release-patch:
	just changelog
	git add CHANGELOG.md
	git commit -m "chore: release patch version"
	git tag v$(cat VERSION | awk -F. '{print $1"."$2"."$3+1}')

release-minor:
	just changelog
	git add CHANGELOG.md
	git commit -m "chore: release minor version"
	git tag v$(cat VERSION | awk -F. '{print $1"."$2+1".0"}')

release-major:
	just changelog
	git add CHANGELOG.md
	git commit -m "chore: release major version"
	git tag v$(cat VERSION | awk -F. '{print $1+1".0.0"}')

# AI agents
opencode:
	opencode

claude:
	claude

# Memory
memory-init:
	mkdir -p .ai-memory/{global,project}

memory-sync:
	@echo "Syncing memory..."
	# Add sync logic here

# Clean
clean:
	@echo "Cleaning build artifacts..."
	@if [ -f "Cargo.toml" ]; then cargo clean; fi
	@if [ -f "pyproject.toml" ]; then rm -rf .venv dist build *.egg-info; fi
	@if [ -f "package.json" ]; then rm -rf node_modules dist build; fi
	rm -rf .cache target

clean-all: clean
	rm -rf .direnv .cargo .rustup .venv node_modules .pnpm